{
  "name": "siavash-agent",
  "version": "0.1.0",
  "description": "Liara deploy + SRE agent (team Siavash)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.15.0",
  "bin": {
    "siavash": "dist/ui/cli/index.js"
  },
  "scripts": {
    "dev": "tsx src/ui/cli/index.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/sre/knowledge/patterns.yaml','dist/sre/knowledge/patterns.yaml')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "check:fa": "tsx scripts/check-fa-strings.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "8.57.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "dotenv": "^17.4.2",
    "execa": "^9.6.1",
    "openai": "^6.49.0",
    "picocolors": "^1.1.1",
    "pino": "^9.14.0",
    "simple-git": "^3.36.0",
    "tar": "^7.5.22",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
